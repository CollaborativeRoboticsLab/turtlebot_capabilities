<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>turtlebot_capabilities</name>
  <version>0.1.0</version>
  <description>Example TurtleBot execution plans and launch files for capabilities2, fabric, perception, and prompt-based workflows.</description>

  <maintainer email="kalanaratnayake95@gmail.com">Kalana Ratnayake</maintainer>
  <maintainer email="kalana.ratnayakemudiyanselage@canberra.edu.au">Kalana Ratnayake</maintainer>

  <author email="kalana.ratnayakemudiyanselage@canberra.edu.au">Kalana Ratnayake</author>
  <author email="kalanaratnayake95@gmail.com">Kalana Ratnayake</author>
  
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <exec_depend>capabilities2_server</exec_depend>
  <exec_depend>fabric_capabilities</exec_depend>
  <exec_depend>fabric_server</exec_depend>
  <exec_depend>fp_perception</exec_depend>
  <exec_depend>fp_perception_capabilities</exec_depend>
  <exec_depend>nav2_capabilities</exec_depend>
  <exec_depend>prompt_bridge</exec_depend>
  <exec_depend>prompt_capabilities</exec_depend>
  <exec_depend>turtlebot4_navigation</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>

    <semantic_capability_interface>
      semantic_interfaces/TurtlebotWaypointRunner.yaml
    </semantic_capability_interface>

    <semantic_capability_interface>
      semantic_interfaces/TurtlebotRobotposeRunner.yaml
    </semantic_capability_interface>

    <semantic_capability_interface>
      semantic_interfaces/TurtlebotTranscribeRunner.yaml
    </semantic_capability_interface>

    <semantic_capability_interface>
      semantic_interfaces/TurtlebotSpeechRunner.yaml
    </semantic_capability_interface>

    <semantic_capability_interface>
      semantic_interfaces/TurtlebotSentimentRunner.yaml
    </semantic_capability_interface>

    <semantic_capability_interface>
      semantic_interfaces/TurtlebotImageAnalysisRunner.yaml
    </semantic_capability_interface>

    <capability_interface>
      interfaces/TurtlebotSlamLaunchRunner.yaml
    </capability_interface>

    <capability_interface>
      interfaces/TurtlebotPerceptionLaunchRunner.yaml
    </capability_interface>

    <capability_provider>
      providers/TurtlebotSlamLaunchRunner.yaml
    </capability_provider>

    <capability_provider>
      providers/TurtlebotNav2LaunchRunner.yaml
    </capability_provider>

    <capability_provider>
      providers/TurtlebotPerceptionLaunchRunner.yaml
    </capability_provider>

    <capability_provider>
      providers/TranscribeRunner.yaml
    </capability_provider>

    <capability_provider>
      providers/SpeechRunner.yaml
    </capability_provider>

    <capability_provider>
      providers/SentimentRunner.yaml
    </capability_provider>

    <capability_provider>
      providers/ImageAnalysisRunner.yaml
    </capability_provider>
  </export>
</package>
